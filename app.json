{
  "expo": {
    "name": "Golf Coach",
    "slug": "golf-coach-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "webpack",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golfcoach.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2e7d32"
      },
      "package": "com.golfcoach.app"
    }
  }
}

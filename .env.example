# Copy to .env for local development. Never commit a real key.
#
# WARNING: EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build
# time. On web that bundle is public, so a key set here is readable by anyone who
# loads the site. Use this for a local or personal device build only. For a
# deployed site, put the key behind a serverless proxy instead - see DEPLOY.md.
#
# The app works with none of these set: course training briefs fall back to the
# locally computed version, and the coach chat reports that no key is configured.

# 'anthropic' or 'openai'
EXPO_PUBLIC_AI_PROVIDER=anthropic

EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-5

EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4-turbo-preview
